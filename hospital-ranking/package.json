{
  "name": "hospital-ranking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --test tests/data-integrity.test.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.mjs",
    "validate:data": "python etl/priceos_validate.py --strict && node --test tests/data-integrity.test.mjs",
    "build:data": "python etl/build_dataset.py",
    "ingest:prices": "python etl/ingest_mrf_prices.py",
    "ingest:prices:offline": "python etl/ingest_mrf_prices.py --offline",
    "ingest:trilliant": "python etl/ingest_trilliant.py --rescan-cache",
    "ingest:trilliant:batch": "python etl/ingest_trilliant.py --oria --append --workers 6",
    "ingest:trilliant:full": "python etl/run_trilliant_batches.py --batch-size 250 --workers 6",
    "ingest:trilliant:cache": "python etl/ingest_trilliant.py --rescan-cache",
    "build:observations": "python etl/migrate_to_observation_store.py",
    "build:browser-data": "python etl/build_browser_data.py"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
