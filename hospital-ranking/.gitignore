# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Trilliant ORIA bulk downloads (large; regenerate via ingest:trilliant)
/data/trilliant/cache/
/data/trilliant/extracts/
/data/cms/trilliant-progress-backup-*.json
/data/trilliant/oria-search-index.json
/data/cms/.trilliant-ingest.lock
/data/trilliant/*.duckdb
/data/trilliant/*.parquet
/data/trilliant/*.zip

.vercel

# Direct hospital MRF ingest (etl/ingest_mrf_prices.py). Extracts are persisted
# on a separate branch by CI, never on main; downloads are deleted after extraction.
/data/mrf/cache/
/data/mrf/downloads/
/data/mrf/extracts/
/data/cms/.mrf-ingest.lock
