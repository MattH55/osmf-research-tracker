{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Price Observation",
  "description": "A single atomic price observation—US or international, cash or negotiated, bundled or unbundled.",
  "type": "object",
  "required": [
    "amount_native",
    "amount_usd",
    "bundle",
    "currency",
    "facility_id",
    "fx_rate_date",
    "fx_rate_to_usd",
    "is_estimate",
    "observation_date",
    "observation_id",
    "price_type",
    "procedure_slug",
    "provenance",
    "stale"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Deterministic UUIDv5 of source + facility + procedure + price_type (stable across rebuilds)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "facility_id": {
      "type": "string",
      "description": "Foreign key referencing facility.json"
    },
    "procedure_slug": {
      "type": "string",
      "description": "Foreign key referencing procedure ontology (e.g., 'tka', 'cataract')"
    },
    "price_type": {
      "type": "string",
      "enum": [
        "discounted_cash",
        "gross_charge",
        "negotiated",
        "allowed_p10",
        "allowed_median",
        "allowed_p90",
        "published_package",
        "quoted_package",
        "tariff"
      ],
      "description": "Classification of this price"
    },
    "amount_native": {
      "type": "number",
      "description": "Price in native currency (source of truth)",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 500000
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code, native currency ALWAYS"
    },
    "fx_rate_to_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Exchange rate used to convert to USD"
    },
    "fx_rate_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the FX rate"
    },
    "amount_usd": {
      "type": "number",
      "description": "Derived USD amount (recomputed at read time from dated FX table)",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 500000
    },
    "bundle": {
      "type": "object",
      "required": [
        "includes",
        "completeness_score"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "surgeon_fee",
              "facility_fee",
              "anesthesia",
              "implant_device",
              "inpatient_nights",
              "pre_op_workup",
              "post_op_physio",
              "complication_cover",
              "interpreter",
              "airport_transfer",
              "lodging",
              "meals",
              "transportation"
            ]
          },
          "description": "Components explicitly included in this price"
        },
        "inpatient_nights": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Number of inpatient nights included, if specified"
        },
        "physio_sessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Number of post-op physical therapy sessions, if specified"
        },
        "device_brand": {
          "type": [
            "string",
            "null"
          ],
          "description": "Brand of implant device (e.g., 'Zimmer Biomet Persona'), if specified"
        },
        "explicitly_excludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Components explicitly NOT included"
        },
        "completeness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Score indicating what % of canonical bundle is included (0.0–1.0)"
        }
      },
      "description": "Bundle composition and completeness. null is NOT allowed; use explicit empty bundle if unknown."
    },
    "is_advertised_minimum": {
      "type": "boolean",
      "description": "True if this is a 'from $X' advertised floor price"
    },
    "is_estimate": {
      "type": "boolean",
      "const": false,
      "description": "Always false: modelled or estimated prices are not allowed in the store"
    },
    "stale": {
      "type": "boolean",
      "default": false,
      "description": "True if observation_date is more than 18 months before the dataset reference date"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_type",
        "source_url",
        "retrieved_at",
        "extracted_by"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "mrf",
            "clinic_website",
            "disclosure_form",
            "tariff_publication",
            "aggregator",
            "quoted_inquiry",
            "published_package"
          ],
          "description": "Source category"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Mandatory https URL where the price can be verified (the hospital's MRF, else the dataset URL). Never a local path.",
          "pattern": "^https://"
        },
        "source_document_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64}|md5:[a-f0-9]{32})$",
          "description": "Hash of the source document as published by the source (sha256 or the md5 recorded by Trilliant)"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "description": "When we retrieved/scraped the source (ISO 8601)"
        },
        "extracted_by": {
          "type": "string",
          "pattern": "^(adapter:[a-z0-9_]+|human|llm_extraction)$",
          "description": "Who/what extracted this price: 'adapter:<name>', 'human' or 'llm_extraction'"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.9,
          "description": "Confidence in extraction accuracy (especially for LLM-extracted)"
        },
        "source_dataset": {
          "type": [
            "string",
            "null"
          ],
          "description": "Dataset the price was read from when it is not the MRF itself (e.g. Trilliant ORIA package URL)"
        }
      },
      "description": "Provenance: mandatory source URL and observation date, or entry is rejected",
      "additionalProperties": false
    },
    "observation_date": {
      "type": "string",
      "format": "date",
      "description": "Date the price was valid: the source file's last_updated_on. Never the build date.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free-text notes"
    },
    "procedure_id": {
      "type": "string",
      "pattern": "^proc-[a-z0-9-]+$",
      "description": "Foreign key into data/seed/procedures.json (id)"
    },
    "scope": {
      "type": "string",
      "enum": [
        "inpatient_stay",
        "facility_service",
        "professional"
      ],
      "description": "What the amount covers; must be the procedure's canonical scope"
    },
    "match_type": {
      "type": "string",
      "enum": [
        "ms-drg",
        "cpt",
        "hcpcs"
      ]
    },
    "matched_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(MS-DRG|CPT|HCPCS):[0-9A-Z]+$"
      },
      "minItems": 1
    },
    "payer_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Distinct payer/plan rates behind a negotiated amount"
    },
    "amount_low": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "amount_high": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "price_row_id": {
      "type": "string",
      "description": "id of the source row in data/cms/*-prices.json"
    }
  },
  "additionalProperties": false
}
