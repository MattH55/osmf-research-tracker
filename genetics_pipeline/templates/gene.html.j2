{% extends "base.html.j2" %}
{% block content %}
<section class="page-hero gce-hero">
  <div class="hero-eyebrow">Gene</div>
  <h1>{{ gene.symbol }}</h1>
  <p>{{ gene.ensembl_gene_id }} · {{ gene.chrom }}:{{ gene.start }}-{{ gene.end }} (GRCh38) · {{ gene.biotype }}</p>
</section>

<section class="gce-section">
  <h2>Loci pointing to this gene</h2>
  <div class="gce-table-wrap">
    <table class="gce-table">
      <thead><tr><th>Locus</th><th>Assignment</th><th>L2G score</th></tr></thead>
      <tbody>
        {% for lg in locus_genes %}
        <tr><td>{{ lg.locus_id }}</td><td>{{ lg.assignment_method|replace('_',' ') }}{% if lg.nearest_gene %} (nearest gene){% endif %}</td><td>{{ lg.l2g_score if lg.l2g_score is not none else 'not computed (OT L2G not ingested)' }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>Associations</h2>
  <div class="gce-table-wrap">
    <table class="gce-table">
      <thead><tr><th>Grade</th><th>Tier</th><th>Phenotype</th><th>Variant</th><th>Effect</th><th>P</th></tr></thead>
      <tbody>
        {% for a in associations %}
        <tr class="gce-tier-row gce-tier-{{ a.tier }}">
          <td><span class="gce-grade gce-grade-{{ a.grade or 'none' }}">{{ a.grade or '—' }}</span></td>
          <td>{{ a.tier }}</td>
          <td><a href="../phenotype/{{ a.phenotype_id }}.html">{{ a.phenotype_label }}</a></td>
          <td><a href="../variant/{{ a.variant_id }}.html">{{ a.rsid or a.variant_id }}</a></td>
          <td>{{ a.effect_measure|upper if a.effect_measure else '' }}={{ a.beta_or_or }}</td>
          <td>{{ '%.2g'|format(a.p_value) if a.p_value else '' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>Pathways</h2>
  <p class="gce-tier-note">Pathway membership (Reactome/GO) is not yet ingested in this build (module 5 — see the
    <a href="{{ root_prefix }}data/genetics/manifest.json">build manifest</a>).</p>

  <h2>RepurpOS</h2>
  <p><a href="{{ root_prefix }}disease-intelligence/index.html">Browse related disease-intelligence and repurposing content →</a></p>
</section>
{% endblock %}
